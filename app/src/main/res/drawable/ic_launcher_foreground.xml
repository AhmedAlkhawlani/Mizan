<?xml version="1.0" encoding="utf-8"?>
<!--
  أيقونة ميزان — الطبقة الأمامية.
  الرمز: حلقة (قدرة تحكّم) + سهمان هابط وصاعد (بيانات) + لؤلؤة في المركز (الخيط العائلي).
  الهندسة من apps/mizan/brand/logo.md بنظام ٥١٢، محوّلة إلى ١٠٨dp بمقياس ٠٫١٩
  (المحتوى ٦٩٫٦dp داخل مربّع ٧٢dp — لا يُقصّ في القصّ الدائري).

  السهمان **مسارات مصمتة** لا خطوط: رسمهما بخط سميك أنتج فتحة صغيرة عند التقاء العمود
  بالرأس (زاوية محدّبة لا تصلها تعبئة الخط)، وهي مرئية عند ٥١٢. المصمت لا يفصل بينهما شيء.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.19"
        android:scaleY="0.19"
        android:translateX="5.4"
        android:translateY="5.4">

        <!-- الحلقة -->
        <path
            android:pathData="M256,80 a176,176 0 1,0 0.1,0 z"
            android:fillColor="#00000000"
            android:strokeWidth="18">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="0"
                    android:endX="0"
                    android:endY="512"
                    android:startColor="#FF00E5FF"
                    android:centerColor="#CC00E5FF"
                    android:endColor="#6600E5FF" />
            </aapt:attr>
        </path>

        <!-- السهمان: مصمتان، متناظران حول المحور -->
        <path
            android:pathData="M179,172 L213,172 L213,300 L227,300 L196,340 L165,300 L179,300 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="196"
                    android:startY="172"
                    android:endX="344"
                    android:endY="340"
                    android:startColor="#FF00E5FF"
                    android:endColor="#FF38CFFF" />
            </aapt:attr>
        </path>
        <path
            android:pathData="M299,340 L333,340 L333,212 L347,212 L316,172 L285,212 L299,212 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="196"
                    android:startY="172"
                    android:endX="344"
                    android:endY="340"
                    android:startColor="#FF00E5FF"
                    android:endColor="#FF38CFFF" />
            </aapt:attr>
        </path>

        <!-- اللؤلؤة -->
        <path
            android:pathData="M256,227 a29,29 0 1,0 0.1,0 z"
            android:fillColor="#FF4081" />
    </group>
</vector>
