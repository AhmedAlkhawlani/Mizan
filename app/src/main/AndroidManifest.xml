<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission: Mizan never talks to a network, and not being able to is
         the strongest privacy statement the app can make (docs/00, docs/02 §9). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ACCESS_NETWORK_STATE is declared by :core:platform, where the ConnectivityManager
         calls live, and merges into this manifest (docs/02 §8). -->
    <!-- Declared, but granted only from Settings (docs/02 §2); the app checks the AppOps mode
         and never assumes the user has switched it on. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Needed on Android 11+ to enumerate installed packages for the per-app list (docs/02 §8).
         No location, no phone state, and still no INTERNET. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mizan">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mizan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- specialUse is the honest type for continuous local measurement; the property below
             is the justification Android 14 requires. -->
        <service
            android:name=".monitoring.MonitoringService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_network_usage_monitoring" />
        </service>

        <service
            android:name=".tile.MizanTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification_monitor"
            android:label="@string/nav_dashboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Resumes monitoring after a reboot when the user had it running. The broadcast is
             a protected system intent, so no other app can trigger it. -->
        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Only reachable through the notification's own PendingIntent, never exported. -->
        <receiver
            android:name=".monitoring.MonitoringActionReceiver"
            android:exported="false" />

        <!-- The «حسناً» action that removes a budget alert; also never exported. -->
        <receiver
            android:name=".alerts.BudgetAlertActionReceiver"
            android:exported="false" />

        <!-- Configuration sheets are launched by the launcher, so they must be visible to it.
             Each one only writes choices for the appWidgetId it was given. -->
        <activity
            android:name=".widget.SpeedWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Mizan" />

        <activity
            android:name=".widget.BudgetWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Mizan" />

        <!-- Home-screen widget providers must be exported so the launcher can bind them. -->
        <receiver
            android:name=".widget.SpeedWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_speed_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/speed_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BudgetWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_budget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/budget_widget_info" />
        </receiver>
    </application>

</manifest>
