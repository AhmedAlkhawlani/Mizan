<?xml version="1.0" encoding="utf-8"?>
<!--
  نسخة أحادية اللون لأيقونات أندرويد ١٣ الملوّنة بالنظام (Themed Icons).
  أندرويد يلوّنها بنفسه، فكل شيء أبيض: الحلقة والسهمان واللؤلؤة.
  المقياس ٠٫١٩ كالطبقة الأمامية، والمحتوى ٦٩٫٦dp داخل مربّع ٧٢dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.19"
        android:scaleY="0.19"
        android:translateX="5.4"
        android:translateY="5.4">

        <!-- الحلقة -->
        <path
            android:pathData="M256,80 a176,176 0 1,0 0.1,0 z"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="18" />

        <!-- السهمان: مصمتان -->
        <path
            android:pathData="M179,172 L213,172 L213,300 L227,300 L196,340 L165,300 L179,300 Z"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M299,340 L333,340 L333,212 L347,212 L316,172 L285,212 L299,212 Z"
            android:fillColor="#FFFFFF" />

        <!-- اللؤلؤة: مصمتة، ولا تُحذف -->
        <path
            android:pathData="M256,227 a29,29 0 1,0 0.1,0 z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
